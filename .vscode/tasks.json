{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-chased3d",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "build_chased3d.ps1"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": {
                "owner": "cc65",
                "fileLocation": [
                    "relative",
                    "${workspaceFolder}"
                ],
                "pattern": {
                    "regexp": "^(.*\\.(?:c|h|ASM|asm)):(\\d+):\\s+(Warning|Error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "severity": 3,
                    "message": 4
                }
            }
        },
        {
            "label": "run-chased3d-altirra",
            "type": "shell",
            "command": "C:\\A8\\Altirra-4.40\\Altirra64.exe",
            "args": [
                "${workspaceFolder}\\Chased3D.atr"
            ],
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "build-and-run-chased3d",
            "dependsOrder": "sequence",
            "dependsOn": [
                "build-chased3d",
                "run-chased3d-altirra"
            ],
            "problemMatcher": []
        },
        {
            "label": "generate-trig-tables",
            "type": "shell",
            "command": "python",
            "args": [
                "gen_trig3d.py"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}
