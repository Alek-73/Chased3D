000000r 1                       .setcpu "6502"
000000r 1               
000000r 1               ; Runs before the generic cc65 Atari startup. With BASIC enabled, OS MEMTOP is
000000r 1               ; low enough that crt0 would place the C software stack inside the program.
000000r 1               
