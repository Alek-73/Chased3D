000003r 1  09 04                ora #$04
000005r 1  8D 03 D3             sta PBCTL
000008r 1  AD 01 D3             lda PORTB
00000Br 1  8D rr rr             sta _startup_portb
00000Er 1  09 02                ora #$02
000010r 1  8D 01 D3             sta PORTB
000013r 1               
000013r 1  AD E5 02             lda MEMTOP
000016r 1  8D rr rr             sta _startup_memtop
000019r 1  AD E6 02             lda MEMTOP+1
00001Cr 1  8D rr rr             sta _startup_memtop+1
00001Fr 1  A9 20                lda #<$BC20
000021r 1  8D E5 02             sta MEMTOP
000024r 1  A9 BC                lda #>$BC20
000026r 1  8D E6 02             sta MEMTOP+1
