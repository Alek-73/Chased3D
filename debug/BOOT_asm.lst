000000r 1                       .setcpu "6502"
000000r 1               
000000r 1               ; Runs before the generic cc65 Atari startup. With BASIC enabled, OS MEMTOP is
000000r 1               ; low enough that crt0 would place the C software stack inside the program.
000000r 1               
000000r 1                       .export basic_off_start
000000r 1                       .import start
000000r 1               
000000r 1               PORTB  = $D301
000000r 1               PBCTL  = $D303
000000r 1               MEMTOP = $02E5
000000r 1               
000000r 1                       .segment "PAGE6CODE"
000000r 1               
000000r 1               basic_off_start:
000000r 1  AD 03 D3             lda PBCTL
000003r 1  09 04                ora #$04
000005r 1  8D 03 D3             sta PBCTL
000008r 1  AD 01 D3             lda PORTB
00000Br 1  09 02                ora #$02
00000Dr 1  8D 01 D3             sta PORTB
000010r 1               
000010r 1  A9 20                lda #<$BC20
000012r 1  8D E5 02             sta MEMTOP
000015r 1  A9 BC                lda #>$BC20
000017r 1  8D E6 02             sta MEMTOP+1
00001Ar 1  4C rr rr             jmp start
00001Ar 1               
