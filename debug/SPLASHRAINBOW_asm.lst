000000r 1                       .setcpu "6502"
000000r 1               
000000r 1                       .export _splash_screen_rainbow
000000r 1               
000000r 1               VCOUNT = $D40B
000000r 1               WSYNC  = $D40A
000000r 1               COLPF2 = $D018
000000r 1               STRIG0 = $D010
000000r 1               CONSOL = $D01F
000000r 1               CH     = $02FC
000000r 1               SDMCTL = $022F
000000r 1               DMACTL = $D400
000000r 1               
000000r 1               STATIC_TITLE = $1E
000000r 1               
000000r 1                       .segment "ZEROPAGE"
000000r 1               rainbow_phase:
000000r 1  xx                   .res 1
000001r 1               rainbow_delay:
000001r 1  xx                   .res 1
000002r 1               
000002r 1                       .segment "CODE"
000000r 1               
000000r 1               ; Playfield color 3 is reserved exclusively for the CHASED 3D title, so it can
000000r 1               ; be changed on every scanline without affecting the bitmap or other text.
000000r 1               ; Joystick fire, START, or any keyboard key dismisses the splash screen.
000000r 1               _splash_screen_rainbow:
000000r 1  A9 00                lda #$00
000002r 1  85 rr                sta rainbow_phase
000004r 1  85 rr                sta rainbow_delay
000006r 1  A9 FF                lda #$FF
000008r 1  8D FC 02             sta CH
00000Br 1               
00000Br 1               rainbow_loop:
00000Br 1  AD 0B D4             lda VCOUNT
00000Er 1  18                   clc
00000Fr 1  65 rr                adc rainbow_phase
000011r 1  8D 0A D4             sta WSYNC
000014r 1  8D 18 D0             sta COLPF2
000017r 1               
000017r 1  E6 rr                inc rainbow_delay
000019r 1  D0 02                bne rainbow_input
00001Br 1  E6 rr                inc rainbow_phase
00001Dr 1               
00001Dr 1               rainbow_input:
00001Dr 1  AD 10 D0             lda STRIG0
000020r 1  F0 0E                beq rainbow_done
000022r 1  AD 1F D0             lda CONSOL
000025r 1  29 01                and #$01
000027r 1  F0 07                beq rainbow_done
000029r 1  AD FC 02             lda CH
00002Cr 1  C9 FF                cmp #$FF
00002Er 1  F0 DB                beq rainbow_loop
000030r 1               
000030r 1               rainbow_done:
000030r 1  A9 FF                lda #$FF
000032r 1  8D FC 02             sta CH
000035r 1  A9 1E                lda #STATIC_TITLE
000037r 1  8D 18 D0             sta COLPF2
00003Ar 1  A9 00                lda #$00
00003Cr 1  8D 2F 02             sta SDMCTL
00003Fr 1  8D 00 D4             sta DMACTL
000042r 1  60                   rts
000042r 1               
